# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Bypasses RLS: used only for anonymous posting, rate limits and jobs.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Used by `npm run db:push` to apply migrations (Connect → Session pooler string).
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# --- App ---
# Keep false until the Supabase setup in README → "Turning on sign-in" is done.
AUTH_ENABLED=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 32 random bytes, base64. Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Salt for hashing IPs in the audit log and rate limits. Generate: openssl rand -hex 32
IP_HASH_SALT=
# Shared secret Vercel Cron sends as a Bearer token. Generate: openssl rand -hex 32
CRON_SECRET=

# --- Observability (optional) ---
SENTRY_DSN=
LOG_LEVEL=info
