# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the example env file
!.env.example

# stray nested clone (delete manually)
/CatsFound/

# supabase local
supabase/.temp/

# playwright
/test-results/
/playwright-report/
/env.local

# generated for the SQL Editor; rebuild with scripts/build-hosted-setup.mjs
supabase/hosted-setup.sql

# local photo storage when no Blob token is set
/.data/
